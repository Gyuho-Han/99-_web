# ─────────────────────────────────────────────────────────────
# KAIRO backend 환경변수
# 이 파일을 .env 로 복사해서 값을 채우세요.  cp .env.example .env
# .env 는 .gitignore 에 있으니 커밋되지 않습니다.
# ─────────────────────────────────────────────────────────────

# 운영에서는 반드시 고정값을 지정한다. 값이 바뀌면 기존 암호문을 복호화할 수 없다.
SECRET_KEY=여기에-충분히-긴-임의-문자열
MASTER_KEY=여기에-Fernet-키   # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

DATABASE_URL=sqlite:///./data/kairo.db
AGENT_TICK_SECONDS=5

# ─── 실거래 잠금 ─────────────────────────────────────────────
# false면 실계좌(live)에서 주문 전송과 자동매매 가동이 서버에서 막힌다.
# 자격증명 등록·연결 테스트·잔고 조회는 그대로 되므로 연결 확인까지는 할 수 있다.
# 모의투자에서 최소 수 주 이상 검증한 뒤에만 true로 바꾼다.
ALLOW_LIVE_TRADING=false

# 미체결 주문 체결 조회 주기(초). 0이면 폴링하지 않는다.
FILL_POLL_SECONDS=20
FILL_POLL_MAX_AGE_DAYS=7

# ─── 한국투자증권 KIS Open API (실시세) ──────────────────────
# KIS 개발자센터 > 앱키 발급에서 받은 값.
# 시세조회 API는 모의투자 도메인에서 지원하지 않으므로 "실전투자" 앱키를 넣는다.
# 이 두 값만 채우면 현재가·일봉이 실제 시장 데이터로 바뀐다.
KIS_APP_KEY=
KIS_APP_SECRET=

# 잔고·주문까지 실제로 붙일 때만 필요 (예: 12345678-01).
# 비워 두면 시세만 실제이고 체결은 내장 시뮬레이터가 처리한다.
KIS_ACCOUNT_NO=

# 실시세를 끄고 싶을 때 false. 키를 지우지 않고도 시뮬레이터로 되돌릴 수 있다.
KIS_MARKET_DATA=true

# 시세 조회 도메인. true면 모의투자(openapivts) 도메인을 쓴다. 기본은 실전.
KIS_MARKET_USE_PAPER=false

# ─── 미국주식 (KIS 해외주식 API) ─────────────────────────────
# 앱키는 위의 KIS_APP_KEY / KIS_APP_SECRET 을 그대로 쓴다. 추가 발급은 없다.
#
# 시세만 볼 거면 아래는 전부 비워 둬도 된다.
# 잔고·주문까지 실제로 붙일 때만 해외주식 계좌번호를 채운다. (예: 50123456-01)
KIS_OVERSEAS_ACCOUNT_NO=

# 미국 실시세를 끄고 싶을 때 false. 국내와 별개로 조절된다.
US_MARKET_DATA=true

# 유니버스에 없는 종목의 기본 거래소. NAS(나스닥) · NYS(뉴욕) · AMS(아멕스)
US_DEFAULT_EXCHANGE=NAS

# 달러를 원화로 환산해 보고 싶을 때만 값을 넣는다. 0이면 USD 그대로 표기한다.
USD_KRW_RATE=0

# KIS 초당 요청 제한 대응 캐시(초)
QUOTE_CACHE_SECONDS=3
CANDLE_CACHE_SECONDS=300
